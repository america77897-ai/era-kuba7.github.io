<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>era_kuba7</title>

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;800&display=swap" rel="stylesheet">

<style>
:root{
  --text:#f5f5f5;
  --muted:#a1a1a1;
  --accent:#7c7cff;
}

*{box-sizing:border-box}

body{
  margin:0;
  font-family:'Inter',system-ui;
  color:var(--text);
  background:linear-gradient(120deg,#0a0a0a,#14143a,#0a0a0a);
  background-size:400% 400%;
  animation:bg 20s ease infinite;
  overflow-x:hidden;
}

@keyframes bg{
  0%{background-position:0% 50%}
  50%{background-position:100% 50%}
  100%{background-position:0% 50%}
}

/* LOADER */
#loader{
  position:fixed;
  inset:0;
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;
  background:#0a0a0a;
  z-index:9999;
  color:#7c7cff;
  font-weight:600;
  letter-spacing:2px;
  transition:opacity .6s ease;
}
.spin{
  width:48px;
  height:48px;
  border:3px solid rgba(124,124,255,.2);
  border-top-color:#7c7cff;
  border-radius:50%;
  animation:spin 1s linear infinite;
  margin-bottom:14px;
}
@keyframes spin{to{transform:rotate(360deg)}}

canvas{position:fixed;inset:0;z-index:-1}

.wrapper{max-width:900px;margin:auto;padding:40px 20px 80px}

.header{display:flex;justify-content:space-between;align-items:center}
.logo{font-weight:800;font-size:18px}

.nav a{
  color:var(--muted);
  text-decoration:none;
  margin-left:20px;
  font-size:14px;
}
.nav a:hover{color:var(--text)}

.hero{
  margin-top:120px;
  display:flex;
  gap:60px;
  align-items:center;
}

.hero h1{
  font-size:64px;
  font-weight:800;
  margin:0;
  line-height:1;
}

.hero p{
  max-width:420px;
  color:var(--muted);
  font-size:16px;
  margin-top:20px;
}

.typing{
  color:var(--accent);
  border-right:2px solid var(--accent);
  padding-right:4px;
  white-space:nowrap;
}

/* AVATAR */
.avatar-wrap{
  width:220px;
  height:220px;
  perspective:900px;
  position:relative;
  cursor:pointer;
}

.avatar{
  width:100%;
  height:100%;
  border-radius:50%;
  background:#111 center/cover no-repeat;
  box-shadow:0 0 40px rgba(124,124,255,.7),
             0 0 120px rgba(124,124,255,.4);
  transition:transform .15s ease;
  position:relative;
  overflow:hidden;
}

/* SCAN LINE */
.avatar::after{
  content:'';
  position:absolute;
  inset:0;
  background:linear-gradient(
    to bottom,
    transparent 40%,
    rgba(124,124,255,.25),
    transparent 60%
  );
  animation:scan 3s linear infinite;
  mix-blend-mode:screen;
}

@keyframes scan{
  from{transform:translateY(-100%)}
  to{transform:translateY(100%)}
}

/* GLITCH */
.avatar.glitch{
  animation:glitch .25s steps(2,end);
}

@keyframes glitch{
  0%{filter:drop-shadow(2px 0 red)}
  50%{filter:drop-shadow(-2px 0 cyan)}
  100%{filter:none}
}

/* INPUT */
#urlBox{
  position:absolute;
  bottom:-50px;
  left:50%;
  transform:translateX(-50%);
  width:260px;
  padding:10px;
  border-radius:12px;
  border:none;
  outline:none;
  background:#0f0f1f;
  color:#fff;
  display:none;
}

.section{margin-top:140px}
.section h2{font-size:28px;margin-bottom:20px}

.card{
  background:rgba(18,18,18,.75);
  backdrop-filter:blur(12px);
  border:1px solid rgba(255,255,255,.05);
  border-radius:20px;
  padding:24px;
  margin-bottom:16px;
}

.reveal{opacity:0;transform:translateY(30px);transition:.8s ease}
.reveal.active{opacity:1;transform:none}

.footer{margin-top:160px;color:var(--muted);font-size:13px}

@media(max-width:700px){
  .hero{flex-direction:column;text-align:center}
  .hero h1{font-size:40px}
}
</style>
</head>

<body>

<div id="loader">
  <div class="spin"></div>
  <span>loading</span>
</div>

<canvas id="stars"></canvas>

<div class="wrapper">

  <div class="header">
    <div class="logo">era_kuba7</div>
    <div class="nav">
      <a href="#about">Обо мне</a>
      <a href="#skills">Skills</a>
      <a href="#contact">Контакты</a>
    </div>
  </div>

  <section class="hero reveal" id="hero">
    <div>
      <h1>Привет, я <span id="typing" class="typing"></span></h1>
      <p>Персональный сайт с неоном, сканером и глитч-эффектами.</p>
    </div>

    <div class="avatar-wrap" id="avatarWrap">
      <div class="avatar" id="avatar"></div>
      <input id="urlBox" placeholder="Вставь ссылку на фото и Enter">
    </div>
  </section>

  <section id="about" class="section reveal">
    <h2>Обо мне</h2>
    <div class="card">Люблю современные интерфейсы и эффекты.</div>
  </section>

  <section id="skills" class="section reveal">
    <h2>Skills</h2>
    <div class="card">HTML / CSS</div>
    <div class="card">JavaScript</div>
  </section>

  <section id="contact" class="section reveal">
    <h2>Контакты</h2>
    <div class="card">Telegram: @era_kuba7</div>
  </section>

  <div class="footer">© 2025 era_kuba7</div>

</div>

<script>
// LOADER
const loader=document.getElementById('loader');
const start=Date.now();
window.addEventListener('load',()=>{
  const wait=Math.max(0,1200-(Date.now()-start));
  setTimeout(()=>{
    loader.style.opacity=0;
    setTimeout(()=>loader.remove(),600);
  },wait);
});

// typing
const text='era_kuba7';
let i=0;
const el=document.getElementById('typing');
(function t(){
  if(i<text.length){
    el.textContent+=text[i++];
    setTimeout(t,120);
  }
})();

// reveal
const reveals=document.querySelectorAll('.reveal');
addEventListener('scroll',()=>{
  const h=innerHeight*.85;
  reveals.forEach(r=>{
    if(r.getBoundingClientRect().top<h) r.classList.add('active');
  });
});

// avatar tilt + glitch
const avatar=document.getElementById('avatar');
avatar.addEventListener('mousemove',e=>{
  const r=avatar.getBoundingClientRect();
  const x=e.clientX-r.left-r.width/2;
  const y=e.clientY-r.top-r.height/2;
  avatar.style.transform=`rotateX(${-y/15}deg) rotateY(${x/15}deg)`;
});
avatar.addEventListener('mouseleave',()=>{
  avatar.style.transform='rotateX(0) rotateY(0)';
});
setInterval(()=>{
  avatar.classList.add('glitch');
  setTimeout(()=>avatar.classList.remove('glitch'),120);
},3000);

// avatar via URL
const box=document.getElementById('urlBox');
document.getElementById('avatarWrap').onclick=()=>{
  box.style.display='block';
  box.focus();
};

box.addEventListener('keydown',e=>{
  if(e.key==='Enter'){
    avatar.style.backgroundImage=`url(${box.value})`;
    localStorage.setItem('avatarURL',box.value);
    box.style.display='none';
    box.value='';
  }
});

// restore avatar
const saved=localStorage.getItem('avatarURL');
if(saved) avatar.style.backgroundImage=`url(${saved})`;

// stars
const c=document.getElementById('stars'),ctx=c.getContext('2d');
let w,h,stars=[];
function resize(){w=c.width=innerWidth;h=c.height=innerHeight}
addEventListener('resize',resize);resize();
for(let i=0;i<120;i++)stars.push({x:Math.random()*w,y:Math.random()*h,r:Math.random()*1.5+0.5,v:Math.random()*.3+.1});
(function anim(){
  ctx.clearRect(0,0,w,h);
  ctx.fillStyle='#fff';
  stars.forEach(s=>{
    s.y+=s.v;
    if(s.y>h) s.y=0;
    ctx.globalAlpha=Math.random();
    ctx.beginPath();
    ctx.arc(s.x,s.y,s.r,0,Math.PI*2);
    ctx.fill();
  });
  ctx.globalAlpha=1;
  requestAnimationFrame(anim);
})();
</script>

</body>
</html>
