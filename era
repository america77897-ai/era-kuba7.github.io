<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Drift Scoreboard Japan</title>

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;800&display=swap" rel="stylesheet">

<style>
:root{
  --text:#f5f5f5;
  --muted:#a1a1a1;
  --accent:#7c7cff;
}

*{box-sizing:border-box}

body{
  margin:0;
  font-family:'Inter',system-ui;
  color:var(--text);
  background:linear-gradient(120deg,#0a0a0a,#14143a,#0a0a0a);
  background-size:400% 400%;
  animation:bg 20s ease infinite;
  overflow-x:hidden;
}

@keyframes bg{
  0%{background-position:0% 50%}
  50%{background-position:100% 50%}
  100%{background-position:0% 50%}
}

/* LOADER */
#loader{
  position:fixed;
  inset:0;
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;
  background:#0a0a0a;
  z-index:9999;
  color:#7c7cff;
  font-weight:600;
  letter-spacing:2px;
  transition:opacity .6s ease;
}
.spin{
  width:48px;
  height:48px;
  border:3px solid rgba(124,124,255,.2);
  border-top-color:#7c7cff;
  border-radius:50%;
  animation:spin 1s linear infinite;
  margin-bottom:14px;
}
@keyframes spin{to{transform:rotate(360deg)}}

canvas{position:fixed;inset:0;z-index:-1}

.wrapper{max-width:980px;margin:auto;padding:40px 20px 80px}

.header{display:flex;justify-content:space-between;align-items:center}
.logo{font-weight:800;font-size:18px}

.nav a{
  color:var(--muted);
  text-decoration:none;
  margin-left:20px;
  font-size:14px;
}
.nav a:hover{color:var(--text)}

.hero{
  margin-top:120px;
  display:flex;
  gap:60px;
  align-items:center;
}

.hero h1{
  font-size:58px;
  font-weight:800;
  margin:0;
  line-height:1;
}

.hero p{
  max-width:420px;
  color:var(--muted);
  font-size:16px;
  margin-top:20px;
}

.typing{
  color:var(--accent);
  border-right:2px solid var(--accent);
  padding-right:4px;
  white-space:nowrap;
}

/* SCORE BADGE */
.badge-wrap{
  width:240px;
  height:240px;
  perspective:900px;
  position:relative;
}

.badge{
  width:100%;
  height:100%;
  border-radius:32px;
  background:
    radial-gradient(circle at 30% 20%,rgba(124,124,255,.4),transparent 55%),
    linear-gradient(140deg,#0b0b15,#1a1a3f);
  border:1px solid rgba(255,255,255,.06);
  box-shadow:0 0 40px rgba(124,124,255,.7),
             0 0 120px rgba(124,124,255,.35);
  transition:transform .15s ease;
  position:relative;
  overflow:hidden;
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;
  text-align:center;
  padding:20px;
  gap:12px;
}

.badge span{font-size:12px;color:var(--muted);text-transform:uppercase;letter-spacing:2px}
.badge strong{font-size:44px}
.badge em{font-style:normal;color:var(--accent);font-weight:600}

/* SCAN LINE */
.badge::after{
  content:'';
  position:absolute;
  inset:0;
  background:linear-gradient(
    to bottom,
    transparent 40%,
    rgba(124,124,255,.25),
    transparent 60%
  );
  animation:scan 3s linear infinite;
  mix-blend-mode:screen;
}

@keyframes scan{
  from{transform:translateY(-100%)}
  to{transform:translateY(100%)}
}

/* GLITCH */
.badge.glitch{
  animation:glitch .25s steps(2,end);
}

@keyframes glitch{
  0%{filter:drop-shadow(2px 0 red)}
  50%{filter:drop-shadow(-2px 0 cyan)}
  100%{filter:none}
}

.section{margin-top:140px}
.section h2{font-size:28px;margin-bottom:20px}

.card{
  background:rgba(18,18,18,.75);
  backdrop-filter:blur(12px);
  border:1px solid rgba(255,255,255,.05);
  border-radius:20px;
  padding:24px;
  margin-bottom:16px;
}

.grid{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(240px,1fr));
  gap:18px;
}

.scoreline{
  display:flex;
  justify-content:space-between;
  color:var(--muted);
  font-size:14px;
  margin-top:8px;
}

.tag{
  display:inline-flex;
  align-items:center;
  gap:6px;
  padding:6px 10px;
  border-radius:999px;
  border:1px solid rgba(255,255,255,.08);
  font-size:12px;
  color:var(--muted);
  margin-right:8px;
}

.rating{
  font-size:22px;
  font-weight:700;
}

.reveal{opacity:0;transform:translateY(30px);transition:.8s ease}
.reveal.active{opacity:1;transform:none}

.footer{margin-top:160px;color:var(--muted);font-size:13px}

@media(max-width:700px){
  .hero{flex-direction:column;text-align:center}
  .hero h1{font-size:40px}
  .badge-wrap{width:200px;height:200px}
}
</style>
</head>

<body>

<div id="loader">
  <div class="spin"></div>
  <span>loading</span>
</div>

<canvas id="stars"></canvas>

<div class="wrapper">

  <div class="header">
    <div class="logo">Drift Scoreboard</div>
    <div class="nav">
      <a href="#about">О проекте</a>
      <a href="#scores">Рейтинг</a>
      <a href="#cars">Топ машины</a>
      <a href="#contact">Контакты</a>
    </div>
  </div>

  <section class="hero reveal" id="hero">
    <div>
      <h1>Japan Drift <span id="typing" class="typing"></span></h1>
      <p>Скоринг-панель для топовых японских дрифт-каров: очки за стиль, контроль и зрелищность.</p>
      <div class="tag">⚡ Стиль</div>
      <div class="tag">🎯 Контроль</div>
      <div class="tag">🔥 Угол</div>
    </div>

    <div class="badge-wrap">
      <div class="badge" id="badge">
        <span>Лидер дня</span>
        <strong>96</strong>
        <em>Nissan Silvia S15</em>
      </div>
    </div>
  </section>

  <section id="about" class="section reveal">
    <h2>О проекте</h2>
    <div class="card">
      Здесь мы собираем скоринг по японским дрифт-машинам: оцениваем мощность, баланс шасси, отдачу турбо и
      стабильность в затяжных дугах. Итоговый балл — сумма трёх ключевых показателей.
    </div>
  </section>

  <section id="scores" class="section reveal">
    <h2>Рейтинг по скорингу</h2>
    <div class="grid">
      <div class="card">
        <div class="rating">1. Nissan Silvia S15</div>
        <div class="scoreline"><span>Стиль</span><span>32</span></div>
        <div class="scoreline"><span>Контроль</span><span>31</span></div>
        <div class="scoreline"><span>Угол</span><span>33</span></div>
        <div class="scoreline"><strong>Итого</strong><strong>96</strong></div>
      </div>
      <div class="card">
        <div class="rating">2. Toyota Supra MK4</div>
        <div class="scoreline"><span>Стиль</span><span>30</span></div>
        <div class="scoreline"><span>Контроль</span><span>30</span></div>
        <div class="scoreline"><span>Угол</span><span>32</span></div>
        <div class="scoreline"><strong>Итого</strong><strong>92</strong></div>
      </div>
      <div class="card">
        <div class="rating">3. Nissan Skyline R34</div>
        <div class="scoreline"><span>Стиль</span><span>29</span></div>
        <div class="scoreline"><span>Контроль</span><span>29</span></div>
        <div class="scoreline"><span>Угол</span><span>31</span></div>
        <div class="scoreline"><strong>Итого</strong><strong>89</strong></div>
      </div>
    </div>
  </section>

  <section id="cars" class="section reveal">
    <h2>Топовые японские дрифт-кары</h2>
    <div class="grid">
      <div class="card">
        <h3>Nissan Silvia S15</h3>
        <p>Мощность: 450 л.с. · Привод: задний · Вес: 1240 кг</p>
        <p>Сильные стороны: отзывчивый турбо-отклик, лёгкая настройка угла, стабильная геометрия подвески.</p>
      </div>
      <div class="card">
        <h3>Toyota Supra MK4</h3>
        <p>Мощность: 520 л.с. · Привод: задний · Вес: 1490 кг</p>
        <p>Сильные стороны: высокий крутящий момент, зрелищные перекладки, надёжность на длинных заездах.</p>
      </div>
      <div class="card">
        <h3>Nissan Skyline R34</h3>
        <p>Мощность: 480 л.с. · Привод: задний (конверсия) · Вес: 1500 кг</p>
        <p>Сильные стороны: жёсткое шасси, чёткий контроль траектории, стабильность на высоких скоростях.</p>
      </div>
      <div class="card">
        <h3>Mazda RX-7 FD</h3>
        <p>Мощность: 420 л.с. · Привод: задний · Вес: 1245 кг</p>
        <p>Сильные стороны: лёгкий роторный мотор, быстрые перекладки, плавная динамика.</p>
      </div>
    </div>
  </section>

  <section id="contact" class="section reveal">
    <h2>Контакты</h2>
    <div class="card">Telegram: @era_kuba7 · Тема: Drift Scoreboard</div>
  </section>

  <div class="footer">© 2025 era_kuba7</div>

</div>

<script>
// LOADER
const loader=document.getElementById('loader');
const start=Date.now();
window.addEventListener('load',()=>{
  const wait=Math.max(0,1200-(Date.now()-start));
  setTimeout(()=>{
    loader.style.opacity=0;
    setTimeout(()=>loader.remove(),600);
  },wait);
});

// typing
const text='Scoreboard';
let i=0;
const el=document.getElementById('typing');
(function t(){
  if(i<text.length){
    el.textContent+=text[i++];
    setTimeout(t,120);
  }
})();

// reveal
const reveals=document.querySelectorAll('.reveal');
addEventListener('scroll',()=>{
  const h=innerHeight*.85;
  reveals.forEach(r=>{
    if(r.getBoundingClientRect().top<h) r.classList.add('active');
  });
});

// avatar tilt + glitch
const badge=document.getElementById('badge');
badge.addEventListener('mousemove',e=>{
  const r=badge.getBoundingClientRect();
  const x=e.clientX-r.left-r.width/2;
  const y=e.clientY-r.top-r.height/2;
  badge.style.transform=`rotateX(${-y/15}deg) rotateY(${x/15}deg)`;
});
badge.addEventListener('mouseleave',()=>{
  badge.style.transform='rotateX(0) rotateY(0)';
});
setInterval(()=>{
  badge.classList.add('glitch');
  setTimeout(()=>badge.classList.remove('glitch'),120);
},3000);

// stars
const c=document.getElementById('stars'),ctx=c.getContext('2d');
let w,h,stars=[];
function resize(){w=c.width=innerWidth;h=c.height=innerHeight}
addEventListener('resize',resize);resize();
for(let i=0;i<120;i++)stars.push({x:Math.random()*w,y:Math.random()*h,r:Math.random()*1.5+0.5,v:Math.random()*.3+.1});
(function anim(){
  ctx.clearRect(0,0,w,h);
  ctx.fillStyle='#fff';
  stars.forEach(s=>{
    s.y+=s.v;
    if(s.y>h) s.y=0;
    ctx.globalAlpha=Math.random();
    ctx.beginPath();
    ctx.arc(s.x,s.y,s.r,0,Math.PI*2);
    ctx.fill();
  });
  ctx.globalAlpha=1;
  requestAnimationFrame(anim);
})();
</script>

</body>
</html>
